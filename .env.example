# EMASDEP v3.0 Configuration
EMASDEP_ENV=development

# Database: auto-detected. In Docker compose, PostgreSQL is used via EMASDEP_DATABASE_URL.
# For local dev without Docker, SQLite falls back to ./emasdep_portal.db
# EMASDEP_DATABASE_URL=postgresql://user:pass@host:5432/dbname

# LLM Provider: "openai" (any OpenAI-compatible API), "ollama" (local), or "mock" (offline)
EMASDEP_LLM_PROVIDER=mock
EMASDEP_LLM_API_KEY=
EMASDEP_LLM_BASE_URL=
EMASDEP_LLM_MODEL=gpt-4o-mini
EMASDEP_LLM_TEMPERATURE=0.0
EMASDEP_LLM_MAX_TOKENS=8192

# For Ollama (local), set:
#   EMASDEP_LLM_PROVIDER=ollama
#   EMASDEP_LLM_MODEL=llama3.2:1b  (or any model you have pulled)
#   EMASDEP_LLM_BASE_URL=          (leave blank, auto-detects host.docker.internal:11434)

# For OpenAI-compatible APIs (DeepSeek, Groq, etc.):
#   EMASDEP_LLM_PROVIDER=openai
#   EMASDEP_LLM_API_KEY=sk-...
#   EMASDEP_LLM_BASE_URL=https://api.deepseek.com/v1
#   EMASDEP_LLM_MODEL=deepseek-v4-flash

EMASDEP_MAX_HEALING_ATTEMPTS=3
EMASDEP_AMBIGUITY_THRESHOLD=0.15
EMASDEP_MIN_MUTATION_SCORE=0.85
EMASDEP_SANDBOX_TYPE=none
EMASDEP_TELEMETRY_ENABLED=true
